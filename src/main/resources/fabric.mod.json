{
    "schemaVersion": 1,
    "id": "fraise",
    "version": "0.1.0",
    "name": "Fraise",
    "description": "An experiment with plugins and Fabric.",
    "authors": [
        "skjsjhb"
    ],
    "contact": {
        "homepage": "https://github.com/skjsjhb/Fraise",
        "sources": "https://github.com/skjsjhb/Fraise"
    },
    "license": [
        "AGPL-3.0-or-later",
        "GPL-3.0-only"
    ],
    "icon": "assets/fraise/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "moe.skjsjhb.fraise.Fraise",
                "adapter": "kotlin"
            }
        ],
        "client": [
            {
                "value": "moe.skjsjhb.fraise.FraiseClient",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "fraise.mixins.json",
        {
            "config": "fraise.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.17.0",
        "minecraft": "~1.21.8",
        "java": ">=21",
        "fabric-api": "*",
        "fabric-language-kotlin": "*"
    },
    "accessWidener": "fraise.aw"
}
